# Supabase 프로젝트 > Project Settings > Database에서 확인
# 앱 런타임(Prisma Client)이 사용하는 커넥션 풀링(Transaction pooler, 6543 포트) URL
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# prisma migrate / db pull 전용 direct connection(5432 포트) URL — DDL은 풀링 연결에서 안정적으로 동작하지 않습니다
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# Supabase 프로젝트 > Project Settings > API에서 확인
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# 서버 전용 — 브라우저에 노출 금지 (RLS 우회, 관리자 작업용)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
