generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// 공통 / 내부 담당자
// ─────────────────────────────────────────────

// Supabase Auth의 auth.users.id(uuid)와 1:1로 매칭되는 내부 담당자 계정
model Staff {
  id        String   @id
  name      String
  email     String   @unique
  role      String
  createdAt DateTime @default(now()) @map("created_at")

  assignedCustomers   Customer[]              @relation("CustomerAssignedStaff")
  actionLogs          CustomerActionLog[]
  checklistChecks     CustomerChecklistItem[]
  deviceMappings      DeviceMapping[]
  deviceStatusLogs    DeviceStatusLog[]
  deviceSanitizations DeviceSanitization[]

  @@map("staff")
}

// ─────────────────────────────────────────────
// 고객사 도메인
// ─────────────────────────────────────────────

enum CustomerStatus {
  INQUIRY // 문의접수
  IN_PROGRESS // 진행중
  COMPLETED // 완료
  STOPPED // 진행중지
  PENDING // 진행대기

  @@map("customer_status")
}

model Customer {
  id                    String         @id @default(uuid())
  code                  String         @unique @map("code")
  name                  String
  address               String?
  contactName           String?        @map("contact_name")
  contactPhone          String?        @map("contact_phone")
  contactEmail          String?        @map("contact_email")
  contactDepartment     String?        @map("contact_department")
  facilityScale         String?        @map("facility_scale")
  status                CustomerStatus @default(INQUIRY)
  assignedStaffId       String?        @map("assigned_staff_id")
  assignedStaff         Staff?         @relation("CustomerAssignedStaff", fields: [assignedStaffId], references: [id])
  contractedDeviceCount Int            @default(0) @map("contracted_device_count")

  // 사업자/세금계산서 정보
  businessRegistrationNumber  String? @map("business_registration_number")
  corporateRegistrationNumber String? @map("corporate_registration_number")
  representativeEmail         String? @map("representative_email")
  taxInvoiceEmail             String? @map("tax_invoice_email")

  // 서비스 연동 정보
  domainKey String? @unique @map("domain_key")

  // '서비스 이용중'(완료) 상태로 전환될 때 입력하는 남은 이용 기간 (자유 형식, 예: "12개월")
  remainingUsagePeriod String? @map("remaining_usage_period")

  createdAt DateTime @default(now()) @map("created_at")

  actionLogs     CustomerActionLog[]
  checklistItems CustomerChecklistItem[]
  documents      CustomerDocument[]
  deviceMappings DeviceMapping[]

  @@map("customers")
}

// 문의접수 단계 액션 히스토리
model CustomerActionLog {
  id            String   @id @default(uuid())
  customerId    String   @map("customer_id")
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  actionDate    DateTime @default(now()) @map("action_date")
  content       String
  authorStaffId String?  @map("author_staff_id")
  authorStaff   Staff?   @relation(fields: [authorStaffId], references: [id])

  @@map("customer_action_logs")
}

// 진행중 단계 체크리스트 항목 마스터 (계약서/인수증 업로드, 입소자정보, 시설정보,
// 조감도정보, 조감도 그리기, 개인정보 동의, 내부테스트, 매핑, 계정생성, 밴드 라벨링 등)
// 하드코딩 대신 마스터 테이블로 관리해 향후 항목 추가/순서 변경이 쉽도록 함
model ChecklistItemMaster {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  checklistItems CustomerChecklistItem[]

  @@map("checklist_item_masters")
}

model CustomerChecklistItem {
  id               String              @id @default(uuid())
  customerId       String              @map("customer_id")
  customer         Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  itemId           String              @map("item_id")
  item             ChecklistItemMaster @relation(fields: [itemId], references: [id])
  isChecked        Boolean             @default(false) @map("is_checked")
  checkedAt        DateTime?           @map("checked_at")
  checkedByStaffId String?             @map("checked_by_staff_id")
  checkedByStaff   Staff?              @relation(fields: [checkedByStaffId], references: [id])

  @@unique([customerId, itemId])
  @@map("customer_checklist_items")
}

enum DocumentType {
  CONTRACT // 계약서
  HANDOVER // 인수증
  AERIAL_VIEW // 조감도
  OTHER // 기타

  @@map("document_type")
}

enum DocumentStatus {
  DRAFT // 자동 생성된 초안만 있는 상태
  FINALIZED // 직인 포함 최종본 업로드 완료

  @@map("document_status")
}

// 계약서/인수증/조감도 — 자동 생성 초안 + 직인 포함 최종 업로드본
model CustomerDocument {
  id           String         @id @default(uuid())
  customerId   String         @map("customer_id")
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  docType      DocumentType   @map("doc_type")
  draftFileUrl String?        @map("draft_file_url")
  finalFileUrl String?        @map("final_file_url")
  status       DocumentStatus @default(DRAFT)
  createdAt    DateTime       @default(now()) @map("created_at")

  @@map("customer_documents")
}

// ─────────────────────────────────────────────
// 장비 도메인
// ─────────────────────────────────────────────

// 장비 구분(늘밴드/늘허브/8구차저 등) 마스터 — 확장 가능하도록 별도 테이블로 관리
model DeviceTypeMaster {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String?  @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  devices Device[]

  @@map("device_type_masters")
}

enum DeviceStatus {
  IN_STOCK // 재고
  MAPPING // 매핑중
  RETURN_PENDING // 반납대기
  RETRIEVED // 회수완료
  DAMAGED // 파손입고
  DISPOSED // 폐기

  @@map("device_status")
}

model Device {
  id             String           @id @default(uuid())
  deviceTypeId   String           @map("device_type_id")
  deviceType     DeviceTypeMaster @relation(fields: [deviceTypeId], references: [id])
  deviceName     String           @map("device_name")
  deviceUid      String           @unique @map("device_uid")
  serialNumber   String?          @unique @map("serial_number")
  receivedDate   DateTime?        @map("received_date")
  registeredDate DateTime?        @map("registered_date")
  status         DeviceStatus     @default(IN_STOCK)

  mappings      DeviceMapping[]
  statusLogs    DeviceStatusLog[]
  sanitizations DeviceSanitization[]
  asHistories   DeviceAsHistory[]

  @@map("devices")
}

// 고객사-장비 매핑 이력 — 장비 하나가 여러 고객사를 거칠 수 있으므로 이력 테이블로 관리
model DeviceMapping {
  id              String    @id @default(uuid())
  deviceId        String    @map("device_id")
  device          Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  customerId      String    @map("customer_id")
  customer        Customer  @relation(fields: [customerId], references: [id])
  mappedAt        DateTime  @default(now()) @map("mapped_at")
  unmappedAt      DateTime? @map("unmapped_at")
  mappedByStaffId String?   @map("mapped_by_staff_id")
  mappedByStaff   Staff?    @relation(fields: [mappedByStaffId], references: [id])

  @@map("device_mappings")
}

// 상태 변경 로그 — 장비 상세페이지 타임라인의 핵심 데이터
model DeviceStatusLog {
  id               String        @id @default(uuid())
  deviceId         String        @map("device_id")
  device           Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  fromStatus       DeviceStatus? @map("from_status")
  toStatus         DeviceStatus  @map("to_status")
  changedAt        DateTime      @default(now()) @map("changed_at")
  changedByStaffId String?       @map("changed_by_staff_id")
  changedByStaff   Staff?        @relation(fields: [changedByStaffId], references: [id])
  note             String?

  @@map("device_status_logs")
}

// 회수완료 → 소독 워크플로우
model DeviceSanitization {
  id                 String   @id @default(uuid())
  deviceId           String   @map("device_id")
  device             Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  sanitizedAt        DateTime @default(now()) @map("sanitized_at")
  sanitizedByStaffId String?  @map("sanitized_by_staff_id")
  sanitizedByStaff   Staff?   @relation(fields: [sanitizedByStaffId], references: [id])
  result             String?

  @@map("device_sanitizations")
}

// 파손입고 → AS 이력
model DeviceAsHistory {
  id               String    @id @default(uuid())
  deviceId         String    @map("device_id")
  device           Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  reportedAt       DateTime  @default(now()) @map("reported_at")
  issueDescription String    @map("issue_description")
  handledBy        String?   @map("handled_by")
  resolvedAt       DateTime? @map("resolved_at")
  resolution       String?

  @@map("device_as_histories")
}
